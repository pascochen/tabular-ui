{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["node", "vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    /* tests/site-port.mjs is plain JS so `node` can run it; allowJs lets the
       Playwright config import it with its inferred types, as in apps/storybook. */
    "allowJs": true,

    /* Bundler mode, as in apps/demo. Tabular UI is type-checked through its
       published declarations (dist/*.d.ts), as any consuming app sees them. */
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* React Router's typegen writes each route's types to .react-router/types,
       read beside the route as ./+types/<route>. */
    "rootDirs": [".", "./.react-router/types"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "tests", ".react-router/types/**/*", "*.ts"]
}
