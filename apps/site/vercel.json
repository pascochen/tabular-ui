{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter tabular-ui build && pnpm build",
  "outputDirectory": "build/client",
  "redirects": [
    {
      "source": "/components",
      "destination": "/#components",
      "permanent": false
    },
    {
      "source": "/components/",
      "destination": "/#components",
      "permanent": false
    },
    {
      "source": "/foundations",
      "destination": "/foundations/color",
      "permanent": false
    },
    {
      "source": "/foundations/",
      "destination": "/foundations/color",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/r/:path*",
      "destination": "https://storybook.tabularui.com/r/:path*"
    }
  ]
}
