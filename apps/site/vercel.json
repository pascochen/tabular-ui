{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter tabular-ui build && pnpm build",
  "outputDirectory": "build/client",
  "rewrites": [{ "source": "/r/:path*", "destination": "https://storybook.tabularui.com/r/:path*" }]
}
