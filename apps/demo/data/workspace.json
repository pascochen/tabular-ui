            "type": "code",
            "language": "sql",
            "label": "Duplicate supplier invoice check",
            "code": "-- One supplier invoice number, entered more than once.\n-- The description is no longer compared: \"June\" and \"Jun\" got past it.\nselect supplier_id,\n       supplier_invoice_number,\n       count(*)          as entries,\n       sum(gross_amount) as gross_total\nfrom supplier_invoices\ngroup by supplier_id, supplier_invoice_number\nhaving count(*) > 1;"
