{
  "name": "tabular-ui-workspace",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm build:ui && pnpm build:registry && pnpm build:storybook && pnpm build:demo",
    "build:ui": "pnpm --filter tabular-ui build",
    "build:registry": "pnpm --filter tabular-ui build:registry",
    "build:storybook": "pnpm --filter tabular-ui-storybook build",
    "build:demo": "pnpm --filter tabular-ui-demo build",
    "dev": "pnpm build:ui && pnpm --parallel --filter tabular-ui --filter tabular-ui-demo dev",
    "storybook": "pnpm --filter tabular-ui-storybook storybook",
    "typecheck": "pnpm build:ui && pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0 && stylelint \"packages/ui/src/**/*.css\" --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm --filter tabular-ui-storybook test",
    "test:watch": "pnpm --filter tabular-ui-storybook test:watch",
    "test:playwright": "pnpm --filter tabular-ui-storybook test:playwright",
    "test:visual": "pnpm --filter tabular-ui-storybook test:visual",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build:ui && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.2",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,yml,yaml}": "prettier --write --ignore-unknown"
  }
}
