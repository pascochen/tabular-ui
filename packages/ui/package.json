{
  "name": "tabular-ui",
  "version": "0.0.0",
  "description": "Dense React components and design tokens for finance and operations data tools, agentic UI included.",
  "license": "MIT",
  "author": "Pascal Chenier",
  "homepage": "https://storybook.tabularui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pascochen/tabular-ui.git",
    "directory": "packages/ui"
  },
  "bugs": "https://github.com/pascochen/tabular-ui/issues",
  "keywords": [
    "react",
    "design-system",
    "tailwindcss",
    "base-ui",
    "shadcn",
    "data-table",
    "dashboard",
    "agent"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css",
    "./theme.css": "./dist/styles/theme.css",
    "./palette.css": "./dist/styles/palette.css",
    "./package.json": "./package.json"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "typecheck": "tsc -p tsconfig.json",
    "build:registry": "node scripts/build-registry.mjs",
    "palette": "node scripts/generate-palette.mjs",
    "contrast": "node scripts/check-contrast.mjs"
  },
  "peerDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/source-code-pro": "^5.3.1",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@shadcn/react": "0.3.1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@storybook/react-vite": "^10.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "culori": "4.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.4"
  }
}
