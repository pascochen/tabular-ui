{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting. strict is TypeScript 6's default; it is spelled out so the
       guarantee is visible and survives a future default change. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* For the shadcn CLI only: `shadcn add` reads this to resolve
       components.json's aliases and refuses to run without it. No code
       may import through `@/` (lint enforces it): the package is compiled
       by consuming apps' bundlers, which would each need the alias. */
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"]
}
